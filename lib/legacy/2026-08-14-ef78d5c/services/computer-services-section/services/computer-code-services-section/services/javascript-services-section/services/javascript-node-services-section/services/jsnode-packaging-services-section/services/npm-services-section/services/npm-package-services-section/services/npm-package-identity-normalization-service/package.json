{
  "name": "@red-cup-engineering/npm-package-identity-normalization-service",
  "version": "1.0.0",
  "description": "Pure JSNode package-identity normalization from an admitted package name and explicit owner.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/normalize-jsnode-package-identity.mjs",
  "files": [
    "scripts",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "normalize-jsnode-package-identity": "./scripts/normalize-jsnode-package-identity.mjs"
  },
  "scripts": {
    "check": "node --check scripts/normalize-jsnode-package-identity.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/immutable-json-value-service": "0.1.0",
    "@red-cup-engineering/jsnode-package-identity-leaf-projection-service": "0.1.0",
    "@red-cup-engineering/json-codec-service": "0.1.4",
    "@red-cup-engineering/nonempty-single-line-text-admission-service": "0.1.0",
    "@red-cup-engineering/npm-owner-normalization-service": "0.1.0",
    "@red-cup-engineering/npm-scoped-package-name-formation-service": "0.1.0",
    "@red-cup-engineering/parse-javascript-argv-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  }
}
