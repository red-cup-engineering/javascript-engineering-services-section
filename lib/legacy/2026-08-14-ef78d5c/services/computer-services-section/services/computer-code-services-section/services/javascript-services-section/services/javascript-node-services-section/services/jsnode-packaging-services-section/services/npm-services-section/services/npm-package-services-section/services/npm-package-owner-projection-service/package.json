{
  "name": "@red-cup-engineering/npm-package-owner-projection-service",
  "version": "1.0.1",
  "description": "Projects one explicit repository package path to the currently declared npm owner policy.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/project-jsnode-package-owner.mjs",
  "files": [
    "scripts",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "project-jsnode-package-owner": "./scripts/project-jsnode-package-owner.mjs"
  },
  "scripts": {
    "check": "node --check scripts/project-jsnode-package-owner.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/json-codec-service": "0.1.4",
    "@red-cup-engineering/parse-javascript-argv-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  }
}
