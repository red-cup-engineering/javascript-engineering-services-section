{
  "name": "@red-cup-engineering/classify-cross-package-javascript-file-import-service",
  "version": "0.1.0",
  "description": "Classifies one resolved JavaScript file import by npm package custody and emits a cross-package import or explicit refusal.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/classify-cross-package-javascript-file-import.mjs",
  "bin": {
    "classify-cross-package-javascript-file-import": "./scripts/classify-cross-package-javascript-file-import.mjs"
  },
  "files": [
    "scripts",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/json-codec-service": "0.1.4",
    "@red-cup-engineering/read-javascript-node-standard-input-text-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  },
  "scripts": {
    "check": "node --check scripts/classify-cross-package-javascript-file-import.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24"
  }
}
