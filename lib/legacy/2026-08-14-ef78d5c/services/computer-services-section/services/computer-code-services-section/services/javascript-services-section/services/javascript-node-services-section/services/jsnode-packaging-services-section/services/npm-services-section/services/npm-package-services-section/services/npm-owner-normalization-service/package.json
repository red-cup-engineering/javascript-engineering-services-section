{
  "name": "@red-cup-engineering/npm-owner-normalization-service",
  "version": "0.1.0",
  "description": "Normalizes one admitted npm owner spelling to its unscoped lowercase owner name.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/normalize-npm-owner.mjs",
  "bin": { "normalize-npm-owner": "./scripts/normalize-npm-owner.mjs" },
  "files": ["scripts", "package.json"],
  "dependencies": {
    "@red-cup-engineering/nonempty-single-line-text-admission-service": "0.1.0",
    "@red-cup-engineering/parse-javascript-argv-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  },
  "scripts": {
    "check": "node --check scripts/normalize-npm-owner.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": { "node": ">=22" }
}
