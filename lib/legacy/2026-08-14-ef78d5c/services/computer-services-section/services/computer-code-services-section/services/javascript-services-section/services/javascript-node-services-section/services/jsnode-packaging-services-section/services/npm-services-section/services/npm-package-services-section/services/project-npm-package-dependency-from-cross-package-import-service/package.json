{
  "name": "@red-cup-engineering/project-npm-package-dependency-from-cross-package-import-service",
  "version": "0.1.0",
  "description": "Projects the consumer dependency consequence of one established cross-package import.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/project-npm-package-dependency-from-cross-package-import.mjs",
  "bin": {
    "project-npm-package-dependency-from-cross-package-import": "./scripts/project-npm-package-dependency-from-cross-package-import.mjs"
  },
  "files": ["scripts", "package.json"],
  "dependencies": {
    "@red-cup-engineering/json-codec-service": "0.1.4",
    "@red-cup-engineering/read-javascript-node-standard-input-text-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  },
  "scripts": {
    "check": "node --check scripts/project-npm-package-dependency-from-cross-package-import.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": { "node": ">=24" }
}
