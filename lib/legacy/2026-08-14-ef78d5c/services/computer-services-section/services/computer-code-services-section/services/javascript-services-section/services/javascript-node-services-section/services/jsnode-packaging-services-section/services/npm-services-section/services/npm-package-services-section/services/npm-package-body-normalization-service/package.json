{
  "name": "@red-cup-engineering/npm-package-body-normalization-service",
  "version": "1.0.2",
  "description": "Composes the independently packaged atomic npm package services into one repository-wide package-body normalization reaction.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/normalize-jsnode-package-body.mjs",
  "files": [
    "scripts",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "normalize-jsnode-package-body": "./scripts/normalize-jsnode-package-body.mjs"
  },
  "scripts": {
    "check": "node --check scripts/normalize-jsnode-package-body.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@red-cup-engineering/apply-npm-package-dependency-projection-service": "0.1.0",
    "@red-cup-engineering/apply-npm-package-exports-projection-service": "0.1.0",
    "@red-cup-engineering/convert-javascript-file-imports-to-registry-imports-service": "0.1.0",
    "@red-cup-engineering/json-codec-service": "0.1.4",
    "@red-cup-engineering/npm-package-directory-observation-service": "0.1.0",
    "@red-cup-engineering/npm-package-dependency-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-identity-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-identity-reference-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-manifest-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-owner-projection-service": "1.0.1",
    "@red-cup-engineering/parse-javascript-argv-service": "0.1.0",
    "@red-cup-engineering/project-npm-package-custody-service": "0.1.0",
    "@red-cup-engineering/read-jsnode-package-body-service": "0.1.0",
    "@red-cup-engineering/read-text-file-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0",
    "@red-cup-engineering/write-text-file-service": "0.1.0"
  }
}
