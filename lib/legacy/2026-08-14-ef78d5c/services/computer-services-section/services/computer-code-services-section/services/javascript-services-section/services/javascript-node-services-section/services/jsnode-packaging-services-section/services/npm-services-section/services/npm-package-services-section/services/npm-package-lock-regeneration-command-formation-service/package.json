{
  "name": "@red-cup-engineering/npm-package-lock-regeneration-command-formation-service",
  "version": "0.1.0",
  "description": "Forms the exact shell-free npm command request that regenerates package-lock.json without installing package contents.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/form-npm-package-lock-regeneration-command.mjs",
  "bin": { "form-npm-package-lock-regeneration-command": "./scripts/form-npm-package-lock-regeneration-command.mjs" },
  "files": ["scripts", "package.json"],
  "dependencies": {
    "@red-cup-engineering/immutable-json-value-service": "0.1.0",
    "@red-cup-engineering/json-codec-service": "0.1.4",
    "@red-cup-engineering/parse-javascript-argv-service": "0.1.0",
    "@red-cup-engineering/resolve-filepath-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  },
  "scripts": {
    "check": "node --check scripts/form-npm-package-lock-regeneration-command.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": { "node": ">=22" }
}
