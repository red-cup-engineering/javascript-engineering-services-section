{
  "name": "@red-cup-engineering/npm-package-directory-observation-service",
  "version": "0.1.0",
  "description": "Observes npm package directories beneath one root by composing a filesystem walk with regular-file and package-manifest path projections.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/observe-npm-package-directories.mjs",
  "bin": { "observe-npm-package-directories": "./scripts/observe-npm-package-directories.mjs" },
  "files": ["scripts", "package.json"],
  "dependencies": {
    "@red-cup-engineering/json-codec-service": "0.1.4",
    "@red-cup-engineering/npm-package-manifest-path-selection-service": "0.1.0",
    "@red-cup-engineering/parse-javascript-argv-service": "0.1.0",
    "@red-cup-engineering/path-walking-service": "1.1.0",
    "@red-cup-engineering/project-filepath-directory-service": "0.1.0",
    "@red-cup-engineering/regular-file-path-projection-service": "0.1.0",
    "@red-cup-engineering/resolve-filepath-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  },
  "scripts": {
    "check": "node --check scripts/observe-npm-package-directories.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": { "node": ">=22" }
}
