{
  "name": "@red-cup-engineering/jsnode-package-identity-leaf-projection-service",
  "version": "0.1.0",
  "description": "Projects one admitted prior package name to the repository's normalized JSNode package identity leaf.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/project-jsnode-package-identity-leaf.mjs",
  "bin": { "project-jsnode-package-identity-leaf": "./scripts/project-jsnode-package-identity-leaf.mjs" },
  "files": ["scripts", "package.json"],
  "dependencies": {
    "@red-cup-engineering/nonempty-single-line-text-admission-service": "0.1.0",
    "@red-cup-engineering/npm-package-name-leaf-admission-service": "0.1.0",
    "@red-cup-engineering/parse-javascript-argv-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  },
  "scripts": {
    "check": "node --check scripts/project-jsnode-package-identity-leaf.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": { "node": ">=22" }
}
