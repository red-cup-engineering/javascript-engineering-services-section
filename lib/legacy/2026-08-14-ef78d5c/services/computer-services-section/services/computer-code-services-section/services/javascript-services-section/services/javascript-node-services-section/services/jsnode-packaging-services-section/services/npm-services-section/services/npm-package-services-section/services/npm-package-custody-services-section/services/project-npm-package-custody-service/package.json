{
  "name": "@red-cup-engineering/project-npm-package-custody-service",
  "version": "0.1.0",
  "description": "Projects one admitted npm package-manifest reading to its filesystem custody record.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/project-npm-package-custody.mjs",
  "bin": {
    "project-npm-package-custody": "./scripts/project-npm-package-custody.mjs"
  },
  "files": [
    "scripts",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/json-codec-service": "0.1.4",
    "@red-cup-engineering/npm-package-manifest-admission-service": "0.1.0",
    "@red-cup-engineering/project-filepath-directory-service": "0.1.0",
    "@red-cup-engineering/read-javascript-node-standard-input-text-service": "0.1.0",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.1.0"
  },
  "scripts": {
    "check": "node --check scripts/project-npm-package-custody.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24"
  }
}
