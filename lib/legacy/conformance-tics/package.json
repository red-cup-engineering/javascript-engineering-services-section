{
  "name": "@red-cup-engineering/conformance-tics",
  "version": "0.0.1",
  "type": "module",
  "keywords": [
    "decommissioned",
    "triage"
  ],
  "description": "Live package-conformance service: runs conformance checks on demand for paths registered at startup.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "serve": "node src/server.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "conformance-tics": "./src/server.ts"
  },
  "dependencies": {
    "@emsenn/jsnode-ick": "0.0.1",
    "@red-cup-engineering/http-server": "0.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
