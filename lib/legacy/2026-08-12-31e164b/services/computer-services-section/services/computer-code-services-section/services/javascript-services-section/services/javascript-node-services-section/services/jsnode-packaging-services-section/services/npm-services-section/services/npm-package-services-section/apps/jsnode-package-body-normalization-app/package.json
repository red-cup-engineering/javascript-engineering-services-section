{
  "name": "@red-cup-engineering/npm-package-body-normalization-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Composition app for repository-wide JSNode package-body normalization through independently packaged atomic services.",
  "exports": "./src/normalize-jsnode-package-body.mjs",
  "bin": {
    "normalize-jsnode-package-body": "./scripts/normalize-jsnode-package-body.mjs"
  },
  "scripts": {
    "check": "node --check src/normalize-jsnode-package-body.mjs && node --check scripts/normalize-jsnode-package-body.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/npm-cross-package-module-edge-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-body-observation-service": "1.0.0",
    "@red-cup-engineering/npm-package-dependency-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-identity-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-identity-reference-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-manifest-normalization-service": "1.0.0",
    "@red-cup-engineering/npm-package-owner-projection-service": "1.0.0"
  }
}
