{
  "name": "@red-cup-engineering/audit-node-builtin-imports-service",
  "version": "1.1.0",
  "description": "Audits one JavaScript source text for single-line imports of Node built-in modules that a house service owns.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/audit-node-builtin-imports.mjs",
  "bin": {
    "audit-node-builtin-imports": "scripts/audit-node-builtin-imports.mjs"
  },
  "files": [
    "scripts",
    "README.md",
    "package.json"
  ],
  "dependencies": {},
  "devDependencies": {},
  "scripts": {
    "check": "node --check scripts/audit-node-builtin-imports.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24.2.0"
  }
}
