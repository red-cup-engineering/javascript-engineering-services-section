{
  "name": "@red-cup-engineering/project-javascript-argv-tail-service",
  "version": "0.2.1",
  "description": "Projects an observed JavaScript-host argument vector to the user-supplied argument tail after the runtime and program addresses.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/project-javascript-argv-tail.mjs",
  "bin": {
    "project-javascript-argv-tail": "scripts/project-javascript-argv-tail.mjs"
  },
  "files": [
    "scripts",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/immutable-json-value-service": "0.1.1",
    "@red-cup-engineering/json-codec-service": "0.1.6",
    "@red-cup-engineering/read-javascript-file-export-documentation-service": "0.1.1",
    "@red-cup-engineering/read-javascript-node-standard-input-text-service": "0.2.1",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.2.1"
  },
  "scripts": {
    "check": "node --check scripts/project-javascript-argv-tail.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24"
  }
}
