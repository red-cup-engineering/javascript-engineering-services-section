{
  "name": "@red-cup-engineering/parse-javascript-argv-service",
  "version": "0.2.2",
  "description": "Parses one complete JavaScript-host argument vector against an explicit Node-compatible option grammar.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/parse-javascript-argv.mjs",
  "bin": {
    "parse-javascript-argv": "scripts/parse-javascript-argv.mjs"
  },
  "files": [
    "scripts",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/immutable-json-value-service": "0.1.1",
    "@red-cup-engineering/json-codec-service": "0.1.6",
    "@red-cup-engineering/project-javascript-argv-tail-service": "0.2.1",
    "@red-cup-engineering/read-javascript-file-export-documentation-service": "0.1.1",
    "@red-cup-engineering/read-javascript-node-standard-input-text-service": "0.2.1",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.2.1"
  },
  "scripts": {
    "check": "node --check scripts/parse-javascript-argv.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24"
  }
}
