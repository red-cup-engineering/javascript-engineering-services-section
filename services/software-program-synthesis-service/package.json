{
  "name": "@red-cup-engineering/software-program-synthesis-service",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "description": "One-effect A2A cell that executes a contracted bounded software mission circuit; the inherited runProgram aggregate remains a separate recovery defect.",
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./protocol": "./src/protocol.mjs",
    "./executor": "./src/a2a-executor.mjs",
    "./program-runtime": "./src/program-runtime.mjs",
    "./execution-circuit": "./src/execution-manifold-circuit.mjs"
  },
  "bin": {
    "execute-software-program-a2a-message": "./scripts/execute-a2a-message.mjs",
    "serve-software-program-a2a": "./scripts/serve-a2a.mjs"
  },
  "scripts": {
    "check": "node --check src/protocol.mjs && node --check src/client.mjs && node --check src/a2a-executor.mjs && node --check src/program-runtime.mjs && node --check src/execution-manifold-circuit.mjs && node --check scripts/execute-a2a-message.mjs && node --check scripts/serve-a2a.mjs",
    "test": "node --test",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@union-officer-academy/officer-context-compilation-service": "0.1.1",
