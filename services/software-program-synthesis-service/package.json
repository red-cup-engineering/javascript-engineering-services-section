    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@red-cup-engineering/coding-context-projection-service": "1.0.0",
    "@lenticule-science/hierarchical-circuit-equivalence-assay": "1.0.1",
    "@red-cup-engineering/inference-work-lot-service": "4.0.1",
    "@red-cup-engineering/relation-model-notation-runtime": "8.0.0",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2",
    "@lenticule-science/witness-journal-rdf-projection-service": "workspace:*",
    "@red-cup-engineering/sandbox-command-execution-service": "1.0.0",
    "@red-cup-engineering/software-mission-execution-service": "1.0.1",
    "@red-cup-engineering/planned-transition-admission-service": "0.1.2",
    "@red-cup-engineering/software-program-synthesis-solicitation-service": "1.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
