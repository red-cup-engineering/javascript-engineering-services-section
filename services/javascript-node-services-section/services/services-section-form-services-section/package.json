    "@red-cup-engineering/computer-filepath-engineering-services-section": "0.1.0",
    "@red-cup-engineering/eavt-services-section": "0.14.1",
    "@red-cup-engineering/javascript-node-services-section": "0.3.2",
    "@red-cup-engineering/json-schema-services-section": "0.5.0",
    "@red-cup-engineering/markdown-engineering-services-section": "0.5.2",
    "@red-cup-engineering/node-process-services-section": "0.3.0",
    "@red-cup-engineering/yaml-frontmatter-codec-service": "0.1.8",
