  "private": false,
  "license": "MIT",
  "exports": {
    "./service-section": "./src/service-section.mjs",
    "./engine": "./apps/agentic-organization-services-section-engine/src/cli.mjs",
    "./read-services-section-tree": "./scripts/read-services-section-tree.mjs",
    "./read-services-section-law": "./scripts/read-services-section-law.mjs",
    "./fold-directory-entries-into-services-section-form": "./scripts/fold-directory-entries-into-services-section-form.mjs",
    "./check-services-section-form-conformance": "./scripts/check-services-section-form-conformance.mjs",
    "./measure-services-section-fitness": "./scripts/measure-services-section-fitness.mjs",
    "./derive-services-section-path": "./scripts/derive-services-section-path.mjs",
    "./found-services-section": "./scripts/found-services-section.mjs",
    "./plan-services-section-normalization": "./scripts/plan-services-section-normalization.mjs",
    "./apply-services-section-normalization": "./scripts/apply-services-section-normalization.mjs",
    "./plan-agency-character-normalization": "./scripts/plan-agency-character-normalization.mjs",
    "./plan-agency-record-normalization": "./scripts/plan-agency-record-normalization.mjs",
    "./apply-agency-normalization": "./scripts/apply-agency-normalization.mjs",
    "./agency-layout": "./src/agency-layout.mjs",
    "./agency-layout-data": "./data/records/schemas/agency-layout.json"
  },
  "bin": {
    "agentic-organization-services-section-engine": "apps/agentic-organization-services-section-engine/src/cli.mjs"
  },
  "files": [
    "src",
    "scripts",
    "apps",
