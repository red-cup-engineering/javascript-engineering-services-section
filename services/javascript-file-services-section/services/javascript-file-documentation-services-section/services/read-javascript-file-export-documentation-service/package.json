{
  "name": "@red-cup-engineering/read-javascript-file-export-documentation-service",
  "version": "0.1.5",
  "description": "Reads standard JSDoc attached to exported functions in one JavaScript text-file reading.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./scripts/read-javascript-file-export-documentation.mjs",
    "./description": "./scripts/javascript-export-description.mjs"
  },
  "bin": {
    "read-javascript-file-export-documentation": "scripts/read-javascript-file-export-documentation.mjs"
  },
  "files": [
    "scripts",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/computer-content-engineering-services-section": "0.1.0",
    "@red-cup-engineering/computer-file-engineering-services-section": "0.4.0",
    "@red-cup-engineering/jsonl-services-section": "0.1.0",
    "@red-cup-engineering/javascript-node-services-section": "0.3.2"
  },
  "scripts": {
    "check": "node --check scripts/*.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24"
  }
}
